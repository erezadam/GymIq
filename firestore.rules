rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTrainer() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['trainer', 'admin'];
    }

    // ---- Shared ownership helpers (Stage 3) ----
    // True when an update does NOT touch any of the given ownership/identity
    // keys — i.e. the caller cannot reassign the doc to a different owner.
    function keysImmutable(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // True when `traineeId` is a trainee currently linked to the caller (their
    // recorded trainer). Same check already used by the trainer read/update
    // rules — centralized here so create paths enforce it too.
    function isMyTrainee(traineeId) {
      return get(/databases/$(database)/documents/users/$(traineeId)).data.trainerId == request.auth.uid;
    }

    // ============ USERS ============
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);

      // Allow checking if collection is empty (for first user = admin logic)
      allow list: if isAuthenticated();

      // Users can create their own profile on registration.
      // role is forced to the trainee default and cannot be self-assigned; the
      // record id must equal the uid field (no identity forgery). Promotion to
      // trainer/admin happens only through a managed server path (Admin SDK).
      // NOTE: the legacy client-side "first user = admin" bootstrap is no longer
      // permitted here — the first admin of a fresh deployment must be promoted
      // out-of-band (Admin SDK / console). Production is unaffected (an admin
      // already exists and the collection is never empty again).
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.uid == userId;

      // Trainers can create trainee profiles. Same constraints: role is forced
      // to 'user' (a trainer cannot mint an admin or another trainer), the new
      // doc must belong to this trainer, and uid must match the record id.
      allow create: if isTrainer() &&
        request.resource.data.role == 'user' &&
        request.resource.data.uid == userId &&
        request.resource.data.trainerId == request.auth.uid;

      // Users can update ONLY the closed allow-list of self-editable fields.
      // role/uid/email/createdAt are never self-writable (identity + privilege).
      // trainerId may only be CLEARED (self-disconnect) — self-assigning a real
      // trainer is impossible; that transition is the approveTrainerRequest CF.
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'displayName', 'phoneNumber', 'city',
          'age', 'height', 'weight', 'bodyFatPercentage', 'trainingGoals',
          'injuriesOrLimitations', 'photoURL', 'trainerProfile',
          'lastSeenReleaseNotesAt', 'trainerId', 'updatedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['trainerId'])
          || request.resource.data.trainerId == null);

      // Trainers can update their own trainee profiles (specific fields only,
      // never role/email/uid). Scoped to trainees linked via trainerId.
      allow update: if isTrainer() &&
        resource.data.trainerId == request.auth.uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'uid']));

      // Only admins can delete users
      allow delete: if isAdmin();

      // Admins can read all users
      allow read: if isAdmin();

      // Admins can update any user including role
      allow update: if isAdmin();

      // Trainers can only read profiles of their own trainees (scoped by trainerId)
      allow read: if isTrainer() && resource.data.trainerId == request.auth.uid;

      // Any authenticated user can read trainer profiles (for trainee self-select flow)
      allow read: if isAuthenticated() && resource.data.role == 'trainer';

      // Trainer reads of trainee profiles are restricted to their own trainees
      // via `trainerId == request.auth.uid` (rule above). Broader discovery
      // of unassigned trainees must go through an explicit invite flow.

      // ---- AI Data subcollection (written by Cloud Functions only) ----
      match /aiData/{docId} {
        // Owner, their trainer (scoped), and admins can read
        allow read: if isAuthenticated() &&
          (request.auth.uid == userId ||
           (isTrainer() && get(/databases/$(database)/documents/users/$(userId)).data.trainerId == request.auth.uid) ||
           isAdmin());

        // No direct client writes — only via Cloud Functions (Admin SDK)
        allow write: if false;
      }
    }

    // ============ EXERCISE RECOMMENDATIONS ============
    match /exerciseRecommendations/{recId} {
      // Users can read their own recommendations (recId == uid)
      // Note: read must use recId, not resource.data, because resource.data is null when doc doesn't exist
      allow read: if isAuthenticated() && recId == request.auth.uid;
      allow write: if isAuthenticated() && recId == request.auth.uid;
    }

    // ============ MUSCLES ============
    match /muscles/{muscleId} {
      // Anyone can read muscles
      allow read: if true;

      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ============ EQUIPMENT ============
    match /equipment/{equipmentId} {
      // Anyone can read equipment
      allow read: if true;

      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ============ REPORT TYPES ============
    match /reportTypes/{reportTypeId} {
      // Anyone can read report types
      allow read: if true;

      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ============ BAND TYPES ============
    match /bandTypes/{bandTypeId} {
      // Anyone can read band types
      allow read: if true;

      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ============ EXERCISE SETS ============
    match /exerciseSets/{setId} {
      // Anyone can read exercise sets
      allow read: if true;

      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ============ EXERCISES ============
    match /exercises/{exerciseId} {
      // Anyone can read exercises (for initial load before auth)
      allow read: if true;

      // Allow create if no exercises exist (initial seeding) OR if admin
      allow create: if isAdmin();

      // Only admins can update/delete exercises
      allow update, delete: if isAdmin();
    }

    // ============ WORKOUT SESSIONS ============
    match /workoutSessions/{sessionId} {
      // Users can read their own workout sessions
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Admins can read any workout session (for impersonation / debugging)
      allow read: if isAdmin();

      // Users can create their own workout sessions
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can update their own workout sessions.
      // userId is an ownership field — it must stay pinned to the current owner
      // (an owner cannot reassign the doc to another user).
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        keysImmutable(['userId']);

      // Users can delete their own workout sessions
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Trainers can read their trainees' sessions (if trainee relationship exists)
      // TODO: Implement trainer-trainee relationship
    }

    // ============ WORKOUT HISTORY ============
    match /workoutHistory/{historyId} {
      // Users can read their own workout history
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Admins can read any workout history (for impersonation / debugging)
      allow read: if isAdmin();

      // Users can create their own workout history
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Users can update their own workout history.
      // userId is pinned — an owner cannot reassign the doc to another user.
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        keysImmutable(['userId']);

      // Users can delete their own workout history
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Trainers can only read workout history of their own trainees
      allow read: if isTrainer() &&
        isMyTrainee(resource.data.userId);

      // Trainers can create workouts they report — only for their own trainees.
      allow create: if isTrainer() &&
        request.resource.data.reportedBy == request.auth.uid &&
        isMyTrainee(request.resource.data.userId);
      // Trainers can update workouts they reported; ownership fields stay pinned.
      allow update: if isTrainer() &&
        resource.data.reportedBy == request.auth.uid &&
        keysImmutable(['userId', 'reportedBy']);

      // Trainers can edit workouts of their trainees (workout editing feature);
      // ownership fields stay pinned.
      allow update: if isTrainer() &&
        isMyTrainee(resource.data.userId) &&
        keysImmutable(['userId', 'reportedBy']);
    }

    // ============ WORKOUT TEMPLATES ============
    match /workoutTemplates/{templateId} {
      // Anyone authenticated can read public templates
      allow read: if isAuthenticated() &&
        (resource.data.isPublic == true || resource.data.createdBy == request.auth.uid);

      // Trainers and admins can create templates
      allow create: if isTrainer();

      // Only template owner or admin can update; createdBy stays pinned
      // (an owner cannot reassign the template to another user).
      allow update: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || isAdmin()) &&
        keysImmutable(['createdBy']);

      // Only template owner or admin can delete
      allow delete: if isAuthenticated() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ============ TRAINEE-TRAINER RELATIONSHIPS ============
    match /trainerRelationships/{relationshipId} {
      // Both trainer and trainee can read
      allow read: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid ||
         resource.data.traineeId == request.auth.uid);

      // ---- CREATE ----
      // (1) Trainer creates an active relationship (trainer-initiated path,
      //     used by createTraineeAccount). Preserves existing behavior.
      allow create: if isTrainer() &&
        request.resource.data.trainerId == request.auth.uid &&
        request.resource.data.status == 'active';

      // (2) Trainee requests a trainer (Approval Flow Phase 1).
      //     Must be self, must be 'pending', must be marked as trainee-initiated.
      allow create: if isAuthenticated() &&
        request.resource.data.traineeId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy == 'trainee';

      // ---- UPDATE ----
      // Note: pending → active transition (approval) is performed by a
      // Cloud Function (Admin SDK) which bypasses these rules. The rule
      // below documents the state machine for direct client writes; we keep
      // it so trainer-side rejection works without a CF round-trip.

      // The relationship's two identity fields (trainerId/traineeId) are pinned
      // across every client update below — a state transition must never
      // reassign the relationship to a different party.

      // (1) Trainer rejects a pending request: pending → rejected.
      allow update: if isAuthenticated() &&
        resource.data.trainerId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'rejected' &&
        keysImmutable(['trainerId', 'traineeId']);

      // (2) Trainee cancels their own pending request: pending → cancelled.
      allow update: if isAuthenticated() &&
        resource.data.traineeId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'cancelled' &&
        keysImmutable(['trainerId', 'traineeId']);

      // (3) Either party manages an active/paused relationship.
      //     Covers pause, resume, end, and notes — all existing behavior.
      //     Forbids transitions back to pending (one-way after approval).
      allow update: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid ||
         resource.data.traineeId == request.auth.uid) &&
        resource.data.status in ['active', 'paused'] &&
        request.resource.data.status in ['active', 'paused', 'ended'] &&
        keysImmutable(['trainerId', 'traineeId']);

      // (4) Notes-only update on an ended relationship (preserves
      //     updateRelationshipNotes after disconnect).
      allow update: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid ||
         resource.data.traineeId == request.auth.uid) &&
        resource.data.status == 'ended' &&
        request.resource.data.status == 'ended' &&
        keysImmutable(['trainerId', 'traineeId']);

      // ---- DELETE ----
      // Either party can delete (existing broad rule, preserved).
      allow delete: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid ||
         resource.data.traineeId == request.auth.uid);

      // Admin can read/write all relationships
      allow read, write: if isAdmin();
    }

    // ============ TRAINING PROGRAMS ============
    match /trainingPrograms/{programId} {
      // Trainer and trainee can read their programs
      allow read: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid ||
         resource.data.traineeId == request.auth.uid ||
         isAdmin());

      // Trainers can create programs for their trainees — the target trainee
      // must be linked to this trainer (not an arbitrary user).
      allow create: if isTrainer() &&
        request.resource.data.trainerId == request.auth.uid &&
        isMyTrainee(request.resource.data.traineeId);

      // Trainees can create their OWN standalone workouts (self-built)
      // - Must be a standalone (not a multi-day program)
      // - Must be marked as createdByTrainee
      // - traineeId must match the authenticated user
      allow create: if isAuthenticated() &&
        request.resource.data.traineeId == request.auth.uid &&
        request.resource.data.type == 'standalone' &&
        request.resource.data.createdByTrainee == true;

      // Trainer or admin can update programs; ownership/assignment fields stay
      // pinned (a program cannot be reassigned to a different trainer/trainee).
      allow update: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin()) &&
        keysImmutable(['trainerId', 'traineeId']);

      // Trainee can only update disconnectedByTrainee field (soft delete)
      allow update: if isAuthenticated() &&
        resource.data.traineeId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['disconnectedByTrainee', 'updatedAt']);

      // Trainer or admin can delete programs
      allow delete: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin());

      // Trainee can delete their OWN self-built standalone workouts
      allow delete: if isAuthenticated() &&
        resource.data.traineeId == request.auth.uid &&
        resource.data.createdByTrainee == true;
    }

    // ============ TRAINER MESSAGES ============
    match /trainerMessages/{messageId} {
      // Trainer and trainee can read messages between them
      allow read: if isAuthenticated() &&
        (resource.data.traineeId == request.auth.uid ||
         resource.data.trainerId == request.auth.uid ||
         isAdmin());

      // Trainers can create messages — only to a trainee linked to them.
      allow create: if isTrainer() &&
        request.resource.data.trainerId == request.auth.uid &&
        isMyTrainee(request.resource.data.traineeId);

      // Trainee can only update isRead/readAt/replies
      allow update: if isAuthenticated() &&
        resource.data.traineeId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'readAt', 'replies']);

      // Trainer can update their own messages (edit, add replies); the
      // trainer/trainee assignment stays pinned.
      allow update: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin()) &&
        keysImmutable(['trainerId', 'traineeId']);

      // Trainer or admin can delete messages
      allow delete: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin());
    }

    // ============ AI TRAINER USAGE (Rate Limiting) ============
    match /aiTrainerUsage/{usageId} {
      // Only Cloud Functions can read/write (via Admin SDK)
      // Users can read their own usage for displaying remaining count
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // No direct client writes - only via Cloud Functions
      allow create, update, delete: if false;
    }

    // ============ AI ANALYSIS USAGE (Rate Limiting + Cached Results) ============
    match /aiAnalysisUsage/{usageId} {
      // Users can read their own cached analysis and usage
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // No direct client writes - only via Cloud Functions
      allow create, update, delete: if false;
    }

    // ============ AI PROGRAM USAGE (Rate Limiting) ============
    match /aiProgramUsage/{usageId} {
      // No direct client reads or writes — only via Cloud Functions (Admin SDK)
      allow read, write: if false;
    }

    // ============ WELCOME EMAIL USAGE (Rate Limiting) ============
    match /welcomeEmailUsage/{usageId} {
      // No direct client reads or writes — only via the sendWelcomeEmail
      // Cloud Function (Admin SDK), which enforces per-target/per-caller caps.
      allow read, write: if false;
    }

    // ============ RELEASE NOTES ("What's New") ============
    // Published notes are readable by any authenticated user.
    // Admins can additionally read drafts/archived (needed for the admin UI
    // list, drafts count, and hash-based dedup lookups).
    // Write access is restricted to admins.
    // Note: users can update their own `lastSeenReleaseNotesAt` via the
    // existing /users/{userId} update rule (self-update with no role change).
    match /releaseNotes/{noteId} {
      allow read: if isAuthenticated() &&
        (resource.data.status == 'published' || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    // ============ APP SETTINGS ============
    match /settings/{settingId} {
      // Any authenticated user can read settings
      allow read: if isAuthenticated();

      // Only admins can write settings
      allow create, update, delete: if isAdmin();
    }

    // ============ AI PROMPT LIBRARY ============
    // Admin-editable prompts/models for the AI features (edited at /admin/prompts).
    // Cloud Functions read via Admin SDK (bypasses rules); the release-note
    // CI script reads while signed in as an admin account.
    match /aiPrompts/{promptId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ============ DIAGNOSTIC LOGS ============
    match /diagnosticLogs/{logId} {
      // Users can write logs only with their own auth uid as actor.
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Only admins can read logs.
      allow read: if isAdmin();

      // Logs are immutable — TTL handles cleanup.
      allow update, delete: if false;
    }
  }
}
